{
  "name": "acta-napi",
  "version": "0.8.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sn0wo2/acta.git",
    "directory": "crates/acta-napi"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "napi build --platform --dts ../../../crates/acta-napi/index.d.ts --no-dts-header --js ../../../crates/acta-napi/index.js ../../target/napi/generated",
    "build:release": "napi build --platform --release --dts ../../../crates/acta-napi/index.d.ts --no-dts-header --js ../../../crates/acta-napi/index.js ../../target/napi/generated"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "acta_napi.*.node"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "napi": {
    "name": "acta_napi",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "aarch64-pc-windows-msvc",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin"
      ]
    }
  }
}
